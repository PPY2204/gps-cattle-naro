# Local environment and secrets
.env
.env.*
!.env.example

# Python virtual environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build and package metadata
build/
dist/
*.egg-info/
pip-wheel-metadata/

# GPS runtime data - keep directory placeholders only
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Runtime logs and local databases
*.log
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
