# Runtime settings for Raspberry Pi field recording.
GPS_PORT=/dev/rfcomm0
GPS_BAUD=9600
GPS_RATE_HZ=4
GPS_CONFIGURE_RATE=true
GPS_TIMEOUT_SECONDS=2.0
GPS_RECONNECT_DELAY_SECONDS=3.0
GPS_BLUETOOTH_MAC=94:51:DC:57:BE:12
GPS_RFCOMM_INDEX=0
GPS_RFCOMM_CHANNEL=1

GPS_PROFILE=human
GPS_SUBJECT_ID=COW-NARO-001
GPS_DEVICE_ID=PI-ZERO-01
GPS_MOUNT=COLLAR

# Use a different .env on each SD card. Keep device IDs distinct when data is
# later copied to one analysis machine.
GPS_STORAGE_ROOT=/home/cow-pi/naro-gps-nathan/data
GPS_RAW_DIR=data/raw
GPS_PROCESSED_DIR=data/processed
GPS_ENABLE_SQLITE=false
GPS_MIN_SATELLITES=4
GPS_MAX_HDOP=5.0
GPS_WEB_PORT=8000
